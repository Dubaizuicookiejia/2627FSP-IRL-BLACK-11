<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mooncake Festival | SMA BPK PENABUR Holis</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: "Segoe UI", sans-serif;
      background: #120505;
      color: white;
      overflow-x: hidden;
    }

    /* ================= NAVBAR ================= */

    nav {
      position: fixed;
      top: 0;
      width: 100%;
      padding: 18px 8%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(20, 0, 0, 0.75);
      backdrop-filter: blur(10px);
      z-index: 100;
    }

    .logo {
      font-size: 20px;
      font-weight: bold;
      color: #ffd86b;
    }

    nav ul {
      display: flex;
      gap: 30px;
      list-style: none;
    }

    nav a {
      color: white;
      text-decoration: none;
      transition: 0.3s;
    }

    nav a:hover {
      color: #ffd86b;
    }

    /* ================= HERO ================= */

    .hero {
      min-height: 100vh;
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      overflow: hidden;

      background:
        radial-gradient(circle at 50% 35%, #6f211d 0%, #300909 35%, #120505 75%);
    }

    .moon {
      position: absolute;
      width: 250px;
      height: 250px;
      border-radius: 50%;
      background: #fff3b0;
      box-shadow:
        0 0 30px #ffe98a,
        0 0 80px rgba(255, 222, 100, 0.5);
      top: 15%;
      right: 12%;
    }

    .moon::after {
      content: "";
      position: absolute;
      width: 250px;
      height: 250px;
      border-radius: 50%;
      background: #5b1717;
      left: -45px;
      top: -10px;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 850px;
      padding: 30px;
    }

    .tag {
      color: #ffd86b;
      font-weight: bold;
      letter-spacing: 3px;
      margin-bottom: 20px;
    }

    h1 {
      font-family: Georgia, serif;
      font-size: clamp(45px, 8vw, 90px);
      color: #ffd86b;
      text-shadow: 0 5px 20px rgba(0,0,0,0.5);
    }

    .subtitle {
      font-size: 22px;
      margin: 20px 0;
    }

    .description {
      color: #e9d7c0;
      line-height: 1.8;
      max-width: 650px;
      margin: auto;
    }

    .btn {
      display: inline-block;
      margin-top: 30px;
      padding: 14px 30px;
      border-radius: 30px;
      background: linear-gradient(135deg, #ffd86b, #d99b22);
      color: #3b0808;
      text-decoration: none;
      font-weight: bold;
      transition: 0.3s;
    }

    .btn:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 30px rgba(255, 216, 107, 0.3);
    }

    /* ================= LANTERNS ================= */

    .lantern {
      position: absolute;
      width: 55px;
      height: 70px;
      background: #c92121;
      border-radius: 45%;
      box-shadow: 0 0 20px rgba(255, 50, 30, 0.5);
      animation: swing 3s ease-in-out infinite;
    }

    .lantern::before {
      content: "";
      position: absolute;
      width: 8px;
      height: 25px;
      background: #ffd86b;
      left: 50%;
      top: -25px;
      transform: translateX(-50%);
    }

    .lantern::after {
      content: "";
      position: absolute;
      width: 8px;
      height: 30px;
      background: #ffd86b;
      left: 50%;
      bottom: -30px;
      transform: translateX(-50%);
    }

    .lantern.one {
      top: 12%;
      left: 8%;
    }

    .lantern.two {
      top: 28%;
      left: 20%;
      transform: scale(0.75);
      animation-delay: 1s;
    }

    .lantern.three {
      top: 18%;
      right: 7%;
      transform: scale(0.8);
      animation-delay: 0.5s;
    }

    @keyframes swing {
      0%,100% {
        transform: rotate(-5deg);
      }

      50% {
        transform: rotate(5deg);
      }
    }

    /* ================= SECTION ================= */

    section {
      padding: 100px 8%;
    }

    .section-title {
      text-align: center;
      font-family: Georgia, serif;
      color: #ffd86b;
      font-size: 42px;
      margin-bottom: 15px;
    }

    .section-desc {
      text-align: center;
      color: #d7c3b0;
      max-width: 650px;
      margin: auto auto 50px;
      line-height: 1.7;
    }

    /* ================= INFO CARDS ================= */

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
      max-width: 1100px;
      margin: auto;
    }

    .card {
      background: linear-gradient(
        145deg,
        rgba(117, 27, 27, 0.8),
        rgba(50, 8, 8, 0.9)
      );

      border: 1px solid rgba(255, 216, 107, 0.25);
      padding: 35px;
      border-radius: 20px;
      text-align: center;
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-8px);
      border-color: #ffd86b;
      box-shadow: 0 15px 40px rgba(0,0,0,0.3);
    }

    .icon {
      font-size: 45px;
      margin-bottom: 20px;
    }

    .card h3 {
      color: #ffd86b;
      margin-bottom: 12px;
    }

    .card p {
      color: #d9c5b0;
      line-height: 1.6;
    }

    /* ================= COUNTDOWN ================= */

    .countdown-section {
      background: #200707;
      text-align: center;
    }

    .countdown {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-top: 40px;
      flex-wrap: wrap;
    }

    .time-box {
      width: 120px;
      padding: 20px;
      background: #5c1212;
      border: 1px solid #d69f31;
      border-radius: 15px;
    }

    .time-box span {
      display: block;
      font-size: 40px;
      font-weight: bold;
      color: #ffd86b;
    }

    .time-box small {
      color: #e8d3bd;
    }

    /* ================= ABOUT ================= */

    .about {
      max-width: 900px;
      margin: auto;
      text-align: center;
    }

    .about p {
      line-height: 1.9;
      color: #d9c5b0;
      font-size: 17px;
    }

    /* ================= CTA ================= */

    .cta {
      text-align: center;
      background:
        linear-gradient(rgba(60, 5, 5, .8), rgba(20, 2, 2, .95)),
        url("");
    }

    .cta h2 {
      font-family: Georgia, serif;
      color: #ffd86b;
      font-size: 45px;
      margin-bottom: 20px;
    }

    /* ================= FOOTER ================= */

    footer {
      padding: 30px;
      text-align: center;
      background: #090202;
      color: #9d8370;
      font-size: 14px;
    }

    /* ================= RESPONSIVE ================= */

    @media (max-width: 768px) {

      nav ul {
        display: none;
      }

      .moon {
        width: 150px;
        height: 150px;
        right: -30px;
        top: 12%;
      }

      .moon::after {
        width: 150px;
        height: 150px;
        left: -25px;
      }

      .cards {
        grid-template-columns: 1fr;
      }

      .hero-content {
        padding-top: 100px;
      }

      .subtitle {
        font-size: 18px;
      }
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <nav>
    <div class="logo">🌕 BPK PENABUR HOLIS</div>

    <ul>
      <li><a href="#home">Home</a></li>
      <li><a href="#about">Tentang</a></li>
      <li><a href="#event">Event</a></li>
      <li><a href="#contact">Kontak</a></li>
    </ul>
  </nav>


  <!-- HERO -->
  <section class="hero" id="home">

    <div class="moon"></div>

    <div class="lantern one"></div>
    <div class="lantern two"></div>
    <div class="lantern three"></div>

    <div class="hero-content">

      <div class="tag">SMA BPK PENABUR HOLIS</div>

      <h1>Mooncake Festival</h1>

