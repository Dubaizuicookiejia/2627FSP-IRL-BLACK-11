      <div class="time-box">
        <span id="minutes">00</span>
        <small>Menit</small>
      </div>

      <div class="time-box">
        <span id="seconds">00</span>
        <small>Detik</small>
      </div>

    </div>

  </section>


  <!-- CTA -->
  <section class="cta" id="contact">

    <h2>See You Under The Moon 🌕</h2>

    <p>
      Mari rayakan Mooncake Festival bersama
      SMA BPK PENABUR Holis!
    </p>

    <a href="#" class="btn">
