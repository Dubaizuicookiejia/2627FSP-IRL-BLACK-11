      </div>

    </div>

  </section>


  <!-- COUNTDOWN -->
  <section class="countdown-section">

    <h2 class="section-title">
      Countdown to Festival
    </h2>

    <p class="section-desc">
      Jangan sampai ketinggalan!
    </p>

    <div class="countdown">

      <div class="time-box">
        <span id="days">00</span>
